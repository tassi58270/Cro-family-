# Copier ce fichier en .env.local pour le développement. Ne jamais committer de vraies valeurs.

# Adresse publique du site, sans barre finale.
# Sur Vercel, l'adresse de production est déduite automatiquement si elle est absente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexation par les moteurs de recherche. Reste désactivée jusqu'à la mise en ligne (étape 12).
# Mettre "on" uniquement sur l'environnement de production.
SITE_INDEXING=off

# Base de données Postgres (Supabase en production, avec ?sslmode=require).
# En local : un Postgres 16, puis `npm run db:reset` pour créer les tables.
# Sans cette variable, le site s’affiche vide.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/croy_dev

# Adresses des administrateurs, séparées par des virgules.
ADMIN_EMAILS=
